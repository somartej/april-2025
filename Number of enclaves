class Solution:
    def numEnclaves(self, grid: List[List[int]]) -> int:
        n=len(grid) 
        m=len(grid[0]) 
        visited=[[0]*m for i in range(n)] 
        q=[] 
        for i in range(0,n):
            for j in range(0,m):
                if((i==0 or i==n-1 or j==0 or j==m-1) and (grid[i][j]==1)):
                    visited[i][j]=1 
                    q.append([i,j]) 
        while(q):
            lst=q.pop(0)
            row=lst[0] 
            col=lst[1] 
            for r,c in [[-1,0],[0,1],[1,0],[0,-1]]:
                nRow=row+r 
                nCol=col+c 
                if(nRow>=0 and nRow<n and nCol>=0 and nCol<m and visited[nRow][nCol]==0 and grid[nRow][nCol]==1):
                    visited[nRow][nCol]=1 
                    q.append([nRow,nCol]) 
        count=0 
        for i in range(0,n):
            for j in range(0,m):
                if(visited[i][j]==0 and grid[i][j]==1):
                    count+=1 
        return count 
